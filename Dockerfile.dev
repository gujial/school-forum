# 开发环境Dockerfile
FROM node:18-alpine

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apk add --no-cache \
    curl \
    bash

# 安装pnpm
RUN npm install -g pnpm

# 复制package文件
COPY package*.json ./
COPY pnpm-lock.yaml ./

# 安装依赖
RUN pnpm install

# 创建必要的目录
RUN mkdir -p dynamic/avatars dynamic/media

# 暴露端口
EXPOSE 3000

# 开发环境启动命令
CMD ["pnpm", "run", "dev"] 