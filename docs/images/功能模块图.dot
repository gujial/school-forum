digraph SchoolForumModules {
    rankdir=TB;
    splines=ortho;
    node [shape=box, style=filled, fontname="Arial", fontsize=12];
    edge [fontname="Arial", fontsize=10];

    // ---------------- 前端界面模块 ----------------
    subgraph cluster_frontend {
        label="前端界面模块";
        style=filled; fillcolor=lightyellow;

        pages [label="页面组件\n(首页/详情/编辑/搜索等)"];
        components [label="UI组件\n(帖子卡片/评论区域/导航栏等)"];
        layouts [label="布局组件"];
        composables [label="组合式函数\n(认证/用户状态等)"];
        
        { rank=min; pages; components; layouts; composables }
    }

    // ---------------- 核心功能模块 ----------------
    subgraph cluster_core {
        label="核心功能模块";
        style=filled; fillcolor=lightcyan;

        // 用户管理
        user_auth [label="用户认证\n(登录/注册/登出)"];
        user_profile [label="用户资料管理\n(头像/背景/信息)"];
        user_settings [label="账户设置\n(密码/邮箱/用户名)"];
        user_delete [label="账户删除"];

        // 内容管理
        tweet_management [label="帖子管理\n(发布/编辑/删除)"];
        comment_system [label="评论系统\n(评论/回复/删除)"];
        media_upload [label="媒体上传\n(图片/视频)"];
        tag_system [label="标签系统"];

        // 社交功能
        follow_system [label="关注系统\n(关注/取消关注)"];
        follower_list [label="粉丝列表"];
        following_list [label="关注列表"];
        like_system [label="点赞系统"];
        share_system [label="分享系统"];

        // 搜索功能
        tweet_search [label="帖子搜索"];
        user_search [label="用户搜索"];
        tag_search [label="标签搜索"];

        // 消息系统
        private_message [label="私信系统\n(发送/接收/删除)"];
        message_management [label="消息管理"];
    }

    // ---------------- 管理功能模块 ----------------
    subgraph cluster_admin {
        label="管理功能模块";
        style=filled; fillcolor=lightcoral;

        admin_auth [label="管理员认证"];
        admin_user_management [label="用户管理"];
        content_moderation [label="内容审核"];
        report_management [label="举报管理"];
        system_monitoring [label="系统监控"];
    }

    // ---------------- 文件服务模块 ----------------
    subgraph cluster_file_service {
        label="文件服务模块";
        style=filled; fillcolor=lightseagreen;

        avatar_files [label="头像文件服务"];
        bg_files [label="背景文件服务"];
        media_files [label="媒体文件服务"];
        file_upload [label="文件上传服务"];
    }

    // ---------------- 安全与审核模块 ----------------
    subgraph cluster_security {
        label="安全与审核模块";
        style=filled; fillcolor=lightpink;

        content_moderation_util [label="内容审核工具"];
        auth_util [label="认证工具"];
        admin_auth_util [label="管理员认证工具"];
        report_system [label="举报系统"];
    }

    // ---------------- 数据库模块 ----------------
    subgraph cluster_database {
        label="数据库模块";
        style=filled; fillcolor=lightgray;

        database_util [label="数据库工具"];
        data_models [label="数据模型"];
        data_functions [label="数据库函数"];
        { rank=max; database_util; data_models; data_functions }
    }

    // ---------------- 核心模块内部关系 ----------------
    user_auth -> user_profile -> user_settings -> user_delete;
    tweet_management -> comment_system -> media_upload -> tag_system;
    follow_system -> follower_list -> following_list;
    like_system -> share_system;
    private_message -> message_management;

    // 核心模块间关系
    user_auth -> tweet_management;
    tweet_management -> follow_system;
    tweet_management -> tweet_search;
    user_auth -> user_search;
    tag_system -> tag_search;
    follow_system -> private_message;

    // 前端 -> 核心模块
    pages -> user_auth;
    pages -> tweet_management;
    components -> comment_system;
    composables -> follow_system;

    // 前端 -> 管理模块
    pages -> admin_auth;
    components -> content_moderation;

    // 文件服务 -> 核心模块
    avatar_files -> user_profile;
    bg_files -> user_profile;
    media_files -> media_upload;
    file_upload -> media_upload;

    // 安全模块 -> 核心/管理模块
    content_moderation_util -> tweet_management;
    auth_util -> user_auth;
    admin_auth_util -> admin_auth;
    report_system -> report_management;

    // 管理模块 -> 核心模块
    admin_user_management -> user_auth;
    content_moderation -> tweet_management;
    report_management -> comment_system;

    // 数据库连接
    database_util -> user_auth;
    data_models -> tweet_management;
    data_functions -> media_upload;
    database_util -> admin_user_management;
}
