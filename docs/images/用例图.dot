digraph UseCaseDiagram {
    rankdir=LR;
    fontname="Arial";
    splines=ortho; // 使用直角折线，减少重叠

    node [fontname="Arial", shape=ellipse, fontsize=10];
    edge [fontname="Arial", fontsize=9];

    // 系统边界
    subgraph cluster_use_case_diagram {
        label="校园论坛平台";
        style=dashed;

        // 用户管理
        subgraph cluster_user_management {
            label="用户管理";
            style=dashed;
            register [label="用户注册"];
            login [label="用户登录"];
            logout [label="用户登出"];
            update_profile [label="更新个人资料"];
            change_password [label="修改密码"];
            delete_account [label="删除账户"];
            upload_avatar [label="上传头像"];
            upload_bg [label="上传背景图"];
        }

        // 内容管理
        subgraph cluster_content_management {
            label="内容管理";
            style=dashed;
            create_tweet [label="发布帖子"];
            edit_tweet [label="编辑帖子"];
            delete_tweet [label="删除帖子"];
            add_comment [label="添加评论"];
            reply_comment [label="回复评论"];
            delete_comment [label="删除评论"];
            upload_media [label="上传媒体"];
            add_tags [label="添加标签"];
        }

        // 社交互动
        subgraph cluster_social_interaction {
            label="社交互动";
            style=dashed;
            follow_user [label="关注用户"];
            unfollow_user [label="取消关注"];
            like_tweet [label="点赞帖子"];
            unlike_tweet [label="取消点赞"];
            share_tweet [label="分享帖子"];
            send_message [label="发送私信"];
            view_followers [label="查看粉丝"];
            view_following [label="查看关注"];
        }

        // 搜索浏览
        subgraph cluster_search_browse {
            label="搜索浏览";
            style=dashed;
            search_tweets [label="搜索帖子"];
            search_users [label="搜索用户"];
            search_tags [label="搜索标签"];
            browse_timeline [label="浏览时间线"];
            view_user_profile [label="查看用户资料"];
            view_tweet_detail [label="查看帖子详情"];
            filter_by_tag [label="按标签筛选"];
            sort_by_time [label="按时间排序"];
        }

        // 内容审核
        subgraph cluster_content_moderation {
            label="内容审核";
            style=dashed;
            report_content [label="举报内容"];
            moderate_content [label="内容审核"];
            auto_moderation [label="自动审核"];
            review_reports [label="审核举报"];
            take_action [label="采取行动"];
        }

        // 系统管理
        subgraph cluster_system_management {
            label="系统管理";
            style=dashed;
            manage_users [label="管理用户"];
            manage_content [label="管理内容"];
            view_statistics [label="查看统计"];
            system_monitoring [label="系统监控"];
            backup_data [label="数据备份"];
        }

        // 通知
        subgraph cluster_notification {
            label="通知系统";
            style=dashed;
            send_notification [label="发送通知"];
            receive_notification [label="接收通知"];
            delete_notification [label="删除通知"];
        }
    }

    // 参与者 (靠左)
    { rank=source;
        guest [label="👤 访客\n(Guest)", shape=plaintext];
        user [label="👤 普通用户\n(Student/Teacher)", shape=plaintext];
        admin [label="👤 管理员\n(Administrator)", shape=plaintext];
    }

    // 外部系统 (靠右)
    { rank=sink;
        system [label="🖥 系统\n(System)", shape=plaintext];
        llm_service [label="🤖 LLM服务\n(DeepSeek/Ollama)", shape=plaintext];
    }

    // 普通用户用例
    user -> {register login logout update_profile change_password delete_account upload_avatar upload_bg
             create_tweet edit_tweet delete_tweet add_comment reply_comment delete_comment upload_media add_tags
             follow_user unfollow_user like_tweet unlike_tweet share_tweet send_message view_followers view_following
             search_tweets search_users search_tags browse_timeline view_user_profile view_tweet_detail filter_by_tag sort_by_time
             report_content receive_notification delete_notification};

    // 管理员用例 (继承自普通用户)
    admin -> {moderate_content review_reports take_action manage_users manage_content
              view_statistics system_monitoring backup_data send_notification};

    // 访客用例 (继承自用户)
    guest -> {register browse_timeline view_user_profile view_tweet_detail
              search_tweets search_users search_tags filter_by_tag sort_by_time};

    // 系统用例
    system -> {auto_moderation send_notification backup_data system_monitoring};

    // LLM服务
    llm_service -> auto_moderation;

    // include 关系
    create_tweet -> upload_media [label="<<include>>", style=dashed, constraint=false];
    create_tweet -> add_tags [label="<<include>>", style=dashed, constraint=false];
    add_comment -> moderate_content [label="<<include>>", style=dashed, constraint=false];
    create_tweet -> moderate_content [label="<<include>>", style=dashed, constraint=false];
    report_content -> review_reports [label="<<include>>", style=dashed, constraint=false];
    auto_moderation -> moderate_content [label="<<include>>", style=dashed, constraint=false];

    // extend 关系
    browse_timeline -> filter_by_tag [label="<<extend>>", style=dotted, constraint=false];
    browse_timeline -> sort_by_time [label="<<extend>>", style=dotted, constraint=false];
    view_tweet_detail -> add_comment [label="<<extend>>", style=dotted, constraint=false];
    view_tweet_detail -> like_tweet [label="<<extend>>", style=dotted, constraint=false];
    view_tweet_detail -> share_tweet [label="<<extend>>", style=dotted, constraint=false];
    view_user_profile -> follow_user [label="<<extend>>", style=dotted, constraint=false];
    view_user_profile -> send_message [label="<<extend>>", style=dotted, constraint=false];

    // 泛化关系
    admin -> user [arrowhead=empty];
    user -> guest [arrowhead=empty];
}
