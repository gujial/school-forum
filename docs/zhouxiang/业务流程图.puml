@startuml
title 校园论坛平台业务流程图

' --- 样式设置 ---
skinparam backgroundColor white
skinparam activity {
    BorderColor DimGray
    
    ' 定义不同模块的颜色风格
    BackgroundColor<<Auth>> LightGreen
    BackgroundColor<<Content>> LightPink
    BackgroundColor<<Social>> LightCoral
    BackgroundColor<<Message>> LightSteelBlue
    BackgroundColor<<Manage>> Gold
    BackgroundColor<<Search>> LightSeaGreen
}

start

' --- 1. 用户认证流程 ---
partition "用户认证流程" <<Auth>> {
    if (是新用户?) then (是)
        :用户注册;
    else (否)
        :用户登录;
    endif
    
    repeat
        :身份验证;
    repeat while (验证通过?) is (否/失败)
    -> 是;
    :认证成功;
    :进入系统;
}

' 使用循环结构模拟用户在系统内的持续操作
repeat 

    :选择业务操作;

    ' --- 主业务分支 ---
    switch (操作类型?)

    case ( 发布内容 )
        ' --- 2. 内容发布流程 ---
        partition "内容发布流程" <<Content>> {
            :开始发布;
            :创建内容;
            
            fork
                :上传媒体;
            fork again
                :添加标签;
            fork again
                :仅文本内容;
            end fork
            
            repeat
                :内容审核;
            repeat while (审核通过?) is (否/拒绝)
            -> 是;
            :发布内容;
            :发布完成;
        }

    case ( 社交互动 )
        ' --- 3. 社交互动流程 ---
        partition "社交互动流程" <<Social>> {
            :开始互动;
            :浏览内容;
            
            split
                :点赞操作;
            split again
                :评论操作;
            split again
                :关注操作;
            split again
                :分享操作;
            end split
            
            :互动完成;
        }

    case ( 消息通信 )
        ' --- 4. 消息通信流程 ---
        partition "消息通信流程" <<Message>> {
            :开始通信;
            :编写消息;
            :选择接收者;
            :发送消息;
            :消息投递;
            :接收者通知;
            :通信完成;
        }

    case ( 搜索浏览 )
        ' --- 5. 搜索浏览流程 ---
        partition "搜索浏览流程" <<Search>> {
            :开始搜索;
            :输入查询;
            :执行搜索;
            :过滤结果;
            :显示结果;
            :搜索完成;
        }

    case ( 举报/管理 )
        ' --- 6. 内容管理流程 ---
        partition "内容管理流程" <<Manage>> {
            :开始管理;
            :内容审查;
            
            if (有举报信息?) then (是)
                :举报处理;
                if (违规主体?) then (内容)
                    :内容操作\n(删除/修改);
                else (用户)
                    :用户操作\n(警告/封禁);
                endif
            else (无问题)
            endif
            
            :管理完成;
        }
        
    case ( 退出系统 )
        stop
        
    endswitch

repeat while (继续使用?) is (是)

stop

@enduml