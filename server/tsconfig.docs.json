{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "h3": ["types/h3-shim.d.ts"]
    },
    "types": [
      "node"
    ],
    "lib": [
      "ES2020",
      "DOM"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "api/**/*.ts",
    "util/**/*.ts",
    "types/**/*.d.ts"
  ]
}


