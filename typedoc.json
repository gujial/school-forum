{
    "entryPoints": [
      "server/api/**/*.ts",
      "server/util/*.ts"
    ],
    "tsconfig": "server/tsconfig.docs.json",
    "plugin": ["typedoc-plugin-markdown"],
    "out": "docs/api",
    "readme": "none",
    "excludeInternal": true,
    "excludePrivate": true,
    "excludeExternals": true,
    "categorizeByGroup": false,
    "skipErrorChecking": true
  }